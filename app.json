{
  "expo": {
    "name": "LyfeOS",
    "slug": "lyfeos",
    "version": "2.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "lyfeos",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F8F9FA"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "com.google.android.gms.permission.AD_ID"
      ],
      "package": "com.lyfeos.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#0F0F0F"
      },
      "softwareKeyboardLayoutMode": "pan"
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router"
      ],
      "expo-font",
      "expo-web-browser",
      "expo-updates",
      "@react-native-firebase/app",
      "@react-native-google-signin/google-signin",
      [
        "expo-image-picker",
        {
          "photosPermission": "LyfeOS needs access to your photos to analyze food images."
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-7658674851177824~1838662014",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511"
        }
      ],
      [
        "./plugins/withKotlinVersion",
        {
          "kotlinVersion": "2.0.21"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "54f639f6-a140-4168-afdc-eb3bca56979e"
      }
    },
    "owner": "shivam.2k",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/54f639f6-a140-4168-afdc-eb3bca56979e"
    }
  }
}