# ─── LyfeOS Environment Variables ──────────────────────────────────────────────
# Copy this file to .env.local and fill in your actual keys.
# .env.local is in .gitignore and will never be committed.
# ────────────────────────────────────────────────────────────────────────────────

# USDA FoodData Central API Key
# Get a free key at: https://fdc.nal.usda.gov/api-guide.html
# Leave as DEMO_KEY for rate-limited free access (30 req/hour per IP)
EXPO_PUBLIC_USDA_API_KEY=DEMO_KEY

# Gemini API Key — used server-side only via Metro proxy (/api/gemini)
# This key is NEVER exposed to the React Native bundle — only used in metro.config.js
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
